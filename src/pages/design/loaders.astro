---
import brand from '../../data/brand.json';
import SteelRevealArt from '../../components/loading/SteelRevealArt.astro';
import SteelLoader from '../../components/loading/SteelLoader.astro';
import Brand from '../../components/Brand.astro';
import { withBase } from '../../lib/paths';
import '@fontsource/anton/latin-400.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../../styles/global.css';
import '../../styles/theatre.css';
import '../../styles/brand.css';
import '../../styles/pressure.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pressure intro study | TECHNICSAN</title>
    <meta
      name="description"
      content="TECHNICSAN's selected steel opening animation, built around its pressure identity."
    />
    <meta name="robots" content="noindex,follow" />
    <link
      rel="canonical"
      href={
        new URL(Astro.url.pathname, import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').href
      }
    />
    <link rel="icon" href={withBase('/favicon.svg')} />
  </head>
  <body class="pressure-site pressure-review">
    <SteelLoader locale="en" automatic={false} />
    <a class="skip-link" href="#main">
      Skip to intro study
    </a>
    <header class="pressure-review-header container">
      <a class="review-brand" href={withBase('/en/')} aria-label="TECHNICSAN homepage">
        <Brand variant="light" />
      </a>
      <a class="text-link" href={withBase('/en/')}>
        Back to website
      </a>
    </header>
    <main id="main" class="container">
      <span class="eyebrow">SELECTED MOTION / STEEL REVEAL</span>
      <h1>{brand.slogan}</h1>
      <p>
        The steel shutters reveal the TECHNICSAN wordmark and an abstract pressure motif. It plays
        for 3.5 seconds on the first visit, with reduced-motion and skip controls.
      </p>
      <button class="button button-accent" type="button" data-preview-steel-loader>
        Try selected intro
      </button>
      <div class="pressure-review-stage">
        <SteelRevealArt />
      </div>
      <p>Cement bulker · LPG catalog · Compressors · Mixers · Silos</p>
    </main>
  </body>
</html>
