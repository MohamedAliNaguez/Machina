---
import Catalogue from '../../../components/Catalogue.astro';
import InformationPage from '../../../components/InformationPage.astro';
import { paths, type Section } from '../../../lib/i18n';
import type { Locale } from '../../../lib/types';
export function getStaticPaths() {
  return (['tr', 'en'] as Locale[]).flatMap((locale) =>
    (Object.keys(paths) as Section[])
      .filter((section) => section !== 'categories')
      .map((section) => ({
        params: { locale, section: paths[section][locale] },
        props: { section },
      })),
  );
}
const locale = Astro.params.locale as Locale;
const { section } = Astro.props as { section: Section };
---

{section === 'machines' ? (
  <Catalogue locale={locale} />
) : (
  <InformationPage locale={locale} section={section} />
)}
