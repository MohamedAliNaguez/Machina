---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import PressureArtwork from '../components/PressureArtwork.astro';
---

<Layout
  locale="en"
  title="Page not found"
  description="Find your way back to TECHNICSAN's five product types."
  noindex
>
  <section class="pressure-not-found">
    <div class="container">
      <span class="eyebrow">TECHNICSAN / 404</span>
      <h1 class="metal-title">
        OFF THE
        <br />
        PRESSURE LINE
      </h1>
      <p>The page may have moved, or the address may be incorrect</p>
      <div class="pressure-actions">
        <a class="button button-accent" href={withBase('/en/products/')}>
          Browse products
        </a>
        <a class="text-link" href={withBase('/en/')}>
          Go to homepage
        </a>
      </div>
      <PressureArtwork id="not-found-pressure" />
    </div>
  </section>
</Layout>
