---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
---

<Layout
  locale="en"
  title="Page not found"
  description="The page may have moved, or the address may be incorrect."
  noindex
>
  <section class="steel-not-found">
    <img
      src={withBase('/images/steel/not-found-stage.webp')}
      alt=""
      width="1440"
      height="1000"
      fetchpriority="high"
    />
    <div class="container">
      <div class="metal-title" aria-hidden="true">
        404
      </div>
      <h1>THIS PAGE IS OFF SITE</h1>
      <p>The page may have moved, or the address may be incorrect</p>
      <div class="not-found-actions">
        <a class="button" href={withBase('/en/machines/')}>
          Browse machines
        </a>
        <a class="text-link" href={withBase('/en/')}>
          Go to homepage
        </a>
      </div>
    </div>
    <span class="not-found-caption">SAMPLE IDENTITY · ILLUSTRATIVE EQUIPMENT</span>
  </section>
</Layout>
