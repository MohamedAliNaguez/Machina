---
import { withBase } from '../../lib/paths';
import PressureArtwork from '../PressureArtwork.astro';
import '../../styles/steel-reveal.css';
interface Props {
  brand?: string;
  deferred?: boolean;
}
const { brand = 'TECHNICSAN', deferred = false } = Astro.props;
---

<div class="steel-reveal-art" aria-hidden="true">
  <div class="metal-headline" data-brand={brand}>
    <img src={withBase('/brand/technicsan-wordmark-sharp.svg')} width="1056" height="130" alt="" />
  </div>
  <PressureArtwork id={deferred ? 'intro-pressure' : 'preview-pressure'} />
  <div class="steel-shutters">
    <i />
    <i />
    <i />
  </div>
  <div class="reveal-light" />
</div>
