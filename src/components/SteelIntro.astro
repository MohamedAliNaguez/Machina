---
import Breadcrumbs from './Breadcrumbs.astro';
import { withBase } from '../lib/paths';
import type { Locale } from '../lib/types';
interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  eyebrow?: string;
  note?: string;
  image?: string;
  variant?: string;
  breadcrumbs?: { name: string; href?: string }[];
}
const {
  locale,
  title,
  subtitle,
  eyebrow,
  note,
  image,
  variant = '',
  breadcrumbs = [],
} = Astro.props;
---

<section class:list={['steel-intro', variant]}>
  {image && (
    <img
      class="steel-intro-art"
      src={withBase(image)}
      alt=""
      width="1440"
      height="400"
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="container steel-intro-content">
    {breadcrumbs.length > 0 && <Breadcrumbs locale={locale} items={breadcrumbs} />}
    {eyebrow && <span class="steel-eyebrow">{eyebrow}</span>}
    <h1 class="metal-title">{title}</h1>
    {subtitle && <p class="steel-intro-subtitle">{subtitle}</p>}
    {note && <p class="steel-intro-note">{note}</p>}
    <slot />
  </div>
</section>

<style>
  :global(.pressure-site) .steel-intro::after {
    display: none;
  }
  :global(.pressure-site) .steel-intro {
    background: #f0f4f0;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
    min-height: 0;
    padding-block: 36px;
  }
  :global(.pressure-site) .steel-intro .steel-intro-art {
    display: none;
  }
  :global(.pressure-site) .steel-intro .steel-intro-content {
    padding-block: 0;
  }
  :global(.pressure-site) .steel-intro .metal-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(44px, 6vw, 76px);
    color: var(--primary);
    background: none;
    -webkit-text-fill-color: currentColor;
    text-shadow: none;
    filter: none;
    letter-spacing: -0.025em;
  }
  :global(.pressure-site) .steel-intro .steel-eyebrow,
  :global(.pressure-site) .steel-intro .steel-breadcrumbs,
  :global(.pressure-site) .steel-intro .steel-breadcrumbs a,
  :global(.pressure-site) .steel-intro .steel-intro-subtitle,
  :global(.pressure-site) .steel-intro .steel-intro-note {
    color: var(--muted);
  }
  :global(.pressure-site) .steel-intro .steel-breadcrumbs [aria-current] {
    color: var(--primary);
  }
</style>
