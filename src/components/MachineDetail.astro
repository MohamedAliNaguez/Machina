---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import MachineCard from './MachineCard.astro';
import { getContent } from '../lib/content';
import { l, labels, otherLocale, url, formatNumber } from '../lib/i18n';
import type { Locale, Machine } from '../lib/types';
interface Props {
  locale: Locale;
  machine: Machine;
}
const { locale, machine } = Astro.props;
const { categories, machines, brands } = await getContent();
const category = categories.find((c) => c.id === machine.categoryId)!;
const copy = labels(locale),
  used = machine.kind === 'used';
const related = machines
  .filter(
    (m) =>
      m.id !== machine.id && m.categoryId === machine.categoryId && m.published.includes(locale),
  )
  .sort((a, b) => Number(a.kind === 'used') - Number(b.kind === 'used'))
  .slice(0, 2);
const origin = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const schema = machine.sample
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: machine.name[locale],
        description: machine.summary[locale],
        image: machine.images.map((i) => new URL(withBase(i.src), origin).href),
        model: machine.model,
        sku: machine.id,
        brand: machine.brandId
          ? { '@type': 'Brand', name: brands.find((b) => b.id === machine.brandId)?.name }
          : undefined,
      },
    ];
const staged =
  machine.sample && (machine.categoryId === 'excavators' || machine.categoryId === 'loaders');
const loaderPhoto = machine.categoryId === 'loaders';
const mainPhoto = staged
  ? loaderPhoto
    ? '/images/steel/used-loader.webp'
    : '/images/steel/new-excavator.webp'
  : machine.images[0].src;
const gallery = staged
  ? [
      { src: mainPhoto, alt: machine.images[0].alt },
      {
        src: loaderPhoto
          ? '/images/theatre/detail-used.webp'
          : '/images/steel/catalogue-excavator.webp',
        alt: { tr: 'Temsili makine ayrıntısı', en: 'Illustrative equipment detail' },
      },
      {
        src: loaderPhoto
          ? '/images/steel/catalogue-loader.webp'
          : '/images/theatre/detail-new.webp',
        alt: { tr: 'Temsili makine fotoğrafı', en: 'Illustrative machine photograph' },
      },
    ]
  : machine.images;
const noun = machine.sample
  ? {
      excavators: l(locale, 'Paletli ekskavatör', 'Crawler excavator'),
      loaders: l(locale, 'Lastikli yükleyici', 'Wheel loader'),
      road: l(locale, 'Zemin silindiri', 'Soil compactor'),
      lifting: l(locale, 'Teleskopik yükleyici', 'Telescopic handler'),
      attachments: l(locale, 'Ataşman', 'Attachment'),
    }[machine.categoryId]
  : machine.name[locale].replace(machine.model + ' ', '');
const crumbs = [
  { name: copy.machines, href: url(locale, 'machines') },
  { name: category.name[locale], href: url(locale, 'categories', category.slug[locale]) },
  { name: machine.model },
];
const orderedSpecs = used
  ? [...machine.specs].sort(
      (a, b) => Number(b.value === machine.model) - Number(a.value === machine.model),
    )
  : machine.specs;
const applications =
  machine.sample && machine.categoryId === 'excavators'
    ? [
        l(locale, 'Kazı ve saha hazırlığı', 'Groundwork and site preparation'),
        l(
          locale,
          'Ataşmanları ve saha gereksinimlerini teyit edin',
          'Confirm attachments and site requirements',
        ),
      ]
    : machine.applications[locale];
const contact = url(locale, 'contact') + '?machine=' + encodeURIComponent(machine.id);
---

<Layout
  locale={locale}
  title={machine.name[locale]}
  description={machine.summary[locale]}
  section="machines"
  alternate={
    machine.published.includes(otherLocale(locale))
      ? url(otherLocale(locale), 'machines', machine.slug[otherLocale(locale)])
      : undefined
  }
  breadcrumbs={crumbs}
  schema={schema}
  socialImage={machine.images[0].src}
>
  <section class:list={['steel-product', { 'used-product': used, 'new-product': !used }]}>
    <div class="container product-grid">
      <div class:list={['product-gallery', { 'has-stage': staged }]}>
        <Breadcrumbs locale={locale} items={crumbs} />
        {staged && (
          <div class="product-model metal-title" aria-hidden="true">
            {machine.model}
          </div>
        )}
        <div class="product-main-photo">
          <img
            id="gallery-main"
            src={withBase(mainPhoto)}
            alt={gallery[0].alt[locale]}
            width="900"
            height="550"
            fetchpriority="high"
            loading="eager"
          />
        </div>

        <p class="product-photo-caption">
          {machine.sample
            ? l(
                locale,
                'Temsili fotoğraflar · Satıştaki belirli bir makineyi göstermez',
                'Illustrative photographs — not an actual unit for sale',
              )
            : machine.images.some((i) => i.illustrative)
              ? l(locale, 'Temsili fotoğraflar', 'Illustrative photographs')
              : machine.name[locale]}
        </p>
      </div>
      <div class="product-summary">
        <div class="product-labels">
          <span class:list={['kind-tag', machine.kind]}>{copy[machine.kind]}</span>
          {machine.sample && <span class="sample-tag">{copy.sample}</span>}
        </div>
        {!staged && <p class="product-reference">{machine.model}</p>}
        <h1>
          <span class="sr-only">{machine.model} </span>
          {noun}
        </h1>
        {!used && (
          <p class="product-description">
            {machine.sample && machine.categoryId === 'excavators'
              ? l(
                  locale,
                  'Kazı ve saha hazırlığı için konfigürasyonları inceleyin',
                  'Explore configurations for excavation and site preparation',
                )
              : machine.summary[locale]}
          </p>
        )}
        {used && (
          <p class:list={['product-stock', machine.status]}>
            <span aria-hidden="true"></span>
            {copy[machine.status]}
            {machine.sample && (
              <span class="status-sample">{l(locale, ' · Örnek durum', ' · Sample status')}</span>
            )}
          </p>
        )}
        {used && (
          <div class="product-unit-facts">
            <div>
              <span>{l(locale, 'Üretim yılı', 'Year')}</span>
              <strong>{machine.year || l(locale, 'Teyit edin', 'Confirm')}</strong>
            </div>
            <div>
              <span>{l(locale, 'Çalışma saati', 'Operating hours')}</span>
              <strong>
                {machine.hours !== undefined
                  ? formatNumber(machine.hours, locale) + ' ' + l(locale, 'saat', 'h')
                  : l(locale, 'Teyit edin', 'Confirm')}
              </strong>
            </div>
            <div>
              <span>
                {machine.sample
                  ? l(locale, 'Örnek ağırlık', 'Example weight')
                  : machine.specs[0]?.label[locale]}
              </span>
              <strong>{machine.specs[0]?.value || '—'}</strong>
            </div>
          </div>
        )}
        {machine.sample && (
          <p class="product-note">
            {used
              ? l(
                  locale,
                  'Örnek değerler · Nihai özellikleri satış ekibiyle teyit edin',
                  'Sample figures — confirm final specification with sales',
                )
              : l(
                  locale,
                  'Temsili ekipman · Teknik değerler örnektir',
                  'Illustrative equipment · Specifications are examples',
                )}
          </p>
        )}
        <div class="product-actions">
          <a
            class="button"
            href={
              machine.status === 'sold' ? url(locale, 'categories', category.slug[locale]) : contact
            }
          >
            {machine.status === 'sold'
              ? l(locale, 'Benzer makineleri inceleyin', 'Browse alternatives')
              : used
                ? l(locale, 'Bu makine hakkında bilgi alın', 'Enquire about this machine')
                : copy.quote}
          </a>
          {!used && (
            <a class="text-link" href={contact}>
              {l(locale, 'Konfigürasyonu görüşün', 'Discuss configuration')}
            </a>
          )}
        </div>
        <p class="product-availability">
          {l(
            locale,
            'Stok durumu satış ekibi tarafından teyit edilir',
            'Availability subject to sales confirmation',
          )}
        </p>
        {machine.status === 'sold' && (
          <p class="product-note">
            {l(
              locale,
              'Bu makine satıldı. Benzer seçenekler için satış ekibiyle görüşebilirsiniz.',
              'This machine has been sold. Contact sales to discuss similar equipment.',
            )}
          </p>
        )}
      </div>
      {gallery.length > 1 && (
        <div
          class="gallery-thumbnails"
          role="group"
          aria-label={l(locale, 'Makine fotoğrafları', 'Machine photographs')}
        >
          {gallery.map((photo, index) => (
            <button
              type="button"
              data-gallery-src={withBase(photo.src)}
              data-gallery-alt={photo.alt[locale]}
              data-gallery-index={index}
              aria-pressed={index === 0}
              aria-label={l(locale, 'Fotoğraf ', 'Photo ') + (index + 1)}
            >
              <img src={withBase(photo.src)} alt="" width="220" height="110" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
  </section>
  <div class="container product-lower">
    <section class:list={['product-information', { 'new-information': !used }]}>
      {used && (
        <div class="condition-information">
          <h2>{l(locale, 'KONDİSYON VE BAKIM GEÇMİŞİ', 'CONDITION & SERVICE HISTORY')}</h2>
          {machine.sample ? (
            <>
              <h3>{l(locale, 'Örnek kondisyon alanı', 'Sample condition field')}</h3>
              <p>
                {l(
                  locale,
                  'Doğrulanmış kontrol bulguları, bakım kayıtları ve bilinen kusurlar burada yer alacaktır',
                  'Inspection findings, service records and known defects belong here once verified',
                )}
              </p>
            </>
          ) : (
            <p>{machine.condition?.[locale] || machine.description[locale]}</p>
          )}
        </div>
      )}
      <div class="product-specifications">
        <h2>{l(locale, 'TEKNİK ÖZELLİKLER', used ? 'SPECIFICATION' : 'SPECIFICATIONS')}</h2>
        <div
          class="table-scroll"
          tabindex="0"
          role="region"
          aria-label={l(locale, 'Teknik özellik tablosu', 'Specifications table')}
        >
          <table>
            <caption>
              {machine.sample
                ? l(
                    locale,
                    'Örnek değerler · Nihai özellikleri satış ekibiyle teyit edin',
                    'Sample figures — confirm final specification with sales',
                  )
                : l(
                    locale,
                    'Nihai konfigürasyonu satış ekibiyle teyit edin',
                    'Confirm the final configuration with sales',
                  )}
            </caption>
            <tbody>
              {orderedSpecs.map((spec) => (
                <tr>
                  <th scope="row">{spec.label[locale]}</th>
                  <td>{spec.value === 'DEMO' ? 'Demo' : spec.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {!machine.sample && (
          <p class="section-note">
            {l(locale, 'Kaynak', 'Source')}: {machine.source}
          </p>
        )}
      </div>
      {!used && (
        <div class="configuration-information">
          <h2>{l(locale, 'UYGULAMALAR VE KONFİGÜRASYONLAR', 'APPLICATIONS & CONFIGURATIONS')}</h2>
          <ul>
            {applications.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {machine.brochure ? (
            <a
              class="text-link"
              href={machine.brochure.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {machine.brochure.label[locale]}
            </a>
          ) : (
            machine.sample && (
              <p class="brochure-pending">
                {l(
                  locale,
                  'Broşür · Doğrulanmış belge bekleniyor',
                  'Brochure — pending verified document',
                )}
              </p>
            )
          )}
        </div>
      )}
    </section>
    {!machine.sample && <p class="product-full-description">{machine.description[locale]}</p>}
    {related.length > 0 && (
      <section class="product-related">
        <h2>{l(locale, 'İLGİLİ MAKİNELER', 'RELATED EQUIPMENT')}</h2>
        <div class="related-grid">
          {related.map((item) => (
            <MachineCard machine={item} locale={locale} compact />
          ))}
        </div>
      </section>
    )}
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]').forEach((button) =>
      button.addEventListener('click', () => {
        const main = document.querySelector<HTMLImageElement>('#gallery-main')!;
        main.src = button.dataset.gallerySrc!;
        main.removeAttribute('srcset');
        main.alt = button.dataset.galleryAlt!;
        document
          .querySelector('.product-gallery')
          ?.classList.toggle('gallery-alternate', button.dataset.galleryIndex !== '0');
        document
          .querySelectorAll('[data-gallery-src]')
          .forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      }),
    );
  </script>
</Layout>
