---
import CategoryLanding from './CategoryLanding.astro';
import InteractiveCatalogue from './InteractiveCatalogue.astro';
import type { Category, Locale } from '../lib/types';
interface Props {
  locale: Locale;
  category?: Category;
  brandId?: string;
}
const { locale, category, brandId } = Astro.props;
---

{category ? (
  <CategoryLanding locale={locale} category={category} />
) : (
  <InteractiveCatalogue locale={locale} brandId={brandId} />
)}
