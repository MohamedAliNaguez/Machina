---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import '../styles/catalogue-showroom.css';
import MachineCard from './MachineCard.astro';
import { getContent } from '../lib/content';
import { l, labels, otherLocale, url } from '../lib/i18n';
import type { Category, Locale } from '../lib/types';

interface Props {
  locale: Locale;
  category?: Category;
  brandId?: string;
}
const { locale, category, brandId } = Astro.props;
const { machines, categories, articles } = await getContent();
const copy = labels(locale);
const availableProducts = machines.filter(
  (product) =>
    product.published.includes(locale) &&
    (!category || product.categoryId === category.id) &&
    (!brandId || product.brandId === brandId),
);
// Give each approved family an equal first appearance, then retain the remaining inventory.
const featured = categories.flatMap(
  (type) => availableProducts.find((p) => p.categoryId === type.id) || [],
);
const visible = [...featured, ...availableProducts.filter((p) => !featured.includes(p))];
const title = category?.name[locale] || copy.machines;
const description =
  category?.description[locale] ||
  l(
    locale,
    'Çimento silobası, LPG kataloğu, kompresörler, mikserler ve silolar',
    'Cement bulker, LPG catalog, Compressors, Mixers and Silos',
  );
const crumbs = category
  ? [{ name: copy.machines, href: url(locale, 'machines') }, { name: title }]
  : [];
const guide = articles.find(
  (article) => article.categoryId === category?.id && article.published.includes(locale),
);
---

<Layout
  locale={locale}
  title={title}
  description={description}
  section="machines"
  alternate={url(
    otherLocale(locale),
    category ? 'categories' : 'machines',
    category?.slug[otherLocale(locale)],
  )}
  breadcrumbs={crumbs.length ? crumbs : [{ name: title }]}
>
  <section class="showroom-intro">
    <div class="container showroom-intro-inner">
      <div>
        <span class="eyebrow">{l(locale, 'ÜRÜN KATALOĞU', 'PRODUCT CATALOGUE')}</span>
        <h1>{title}</h1>
      </div>
      <p>{description}</p>
    </div>
  </section>
  <div
    class:list={['container', 'showroom-catalogue', { 'category-catalogue': !!category }]}
    data-catalogue
    data-locale={locale}
    data-fixed-category={category?.id || ''}
    data-fixed-category-name={category?.name[locale] || ''}
  >
    <div class="showroom-toolbar">
      <div class="catalogue-search search-box">
        <img src={withBase('/icons/magnifying-glass.svg')} alt="" width="20" height="20" />
        <label for="machine-search" class="sr-only">
          {l(locale, 'Ürün veya ürün grubu arayın', 'Search products or product types')}
        </label>
        <input
          id="machine-search"
          type="search"
          placeholder={l(
            locale,
            'Model, ürün grubu veya uygulama arayın',
            'Search products by model, family or application',
          )}
          autocomplete="off"
        />
        <button
          type="button"
          data-clear-search
          hidden
          aria-label={l(locale, 'Aramayı temizle', 'Clear search')}
        >
          {l(locale, 'Temizle', 'Clear')}
        </button>
      </div>
      <aside
        id="machine-filters"
        class="filter-panel"
        aria-label={l(locale, 'Ürün filtreleri', 'Product filters')}
      >
        {category ? (
          <nav class="showroom-families" aria-label={l(locale, 'Ürün grupları', 'Product types')}>
            <a class="family-chip" href={url(locale, 'machines')}>
              {copy.all}
            </a>
            {categories.map((type) => (
              <a
                class="family-chip"
                href={url(locale, 'categories', type.slug[locale])}
                aria-current={type.id === category.id ? 'page' : undefined}
              >
                {type.name[locale]}
              </a>
            ))}
          </nav>
        ) : (
          <fieldset class="showroom-families">
            <legend class="sr-only">{l(locale, 'Ürün grupları', 'Product types')}</legend>
            <button type="button" class="family-chip" data-all-categories aria-pressed="true">
              {l(locale, 'Tüm ürünler', 'All products')}
            </button>
            {categories.map((type) => (
              <label class="family-chip">
                <input type="checkbox" data-filter="category" value={type.id} />
                <span>{type.name[locale]}</span>
              </label>
            ))}
          </fieldset>
        )}
      </aside>
    </div>
    <section class="catalogue-results" aria-label={l(locale, 'Ürün sonuçları', 'Product results')}>
      <h2 class="sr-only" tabindex="-1">
        {l(locale, 'Katalogdaki ürünler', 'Products in the catalogue')}
      </h2>
      <div class="showroom-results-bar">
        <p class="results-count" aria-live="polite" aria-atomic="true" data-results-count>
          {visible.length} {l(locale, 'ürün', 'products')}
        </p>
        <button type="button" class="filter-reset" data-reset>
          {l(locale, 'Filtreleri temizle', 'Reset filters')}
        </button>
      </div>
      <div class="machine-grid">
        {visible.map((product, index) => (
          <MachineCard machine={product} locale={locale} priority={index < 3} />
        ))}
      </div>
      <div class="empty-state" data-empty hidden>
        <h2>{l(locale, 'Eşleşen ürün bulunamadı', 'No products match these filters')}</h2>
        <p>
          {l(
            locale,
            'Başka bir ürün arayın veya filtreleri temizleyin.',
            'Try another product or reset the filters.',
          )}
        </p>
        <button type="button" class="button button-outline" data-reset>
          {l(locale, 'Filtreleri temizle', 'Reset filters')}
        </button>
        <a class="text-link" href={url(locale, 'contact')}>
          {l(locale, 'Satış ekibiyle görüşün', 'Contact sales')}
        </a>
      </div>
      <p class="section-note">
        {l(
          locale,
          'TECHNICSAN katalog önizlemesi · Teknik bilgiler ve tedarik onayı bekleniyor',
          'TECHNICSAN catalogue preview · Technical review and supply approval pending',
        )}
      </p>
      <noscript>
        <p class="notice">
          {l(
            locale,
            'Tüm ürünler listelenmiştir. Arama ve filtreler için JavaScript gereklidir.',
            'All products are listed. Search and filters require JavaScript.',
          )}
        </p>
      </noscript>
    </section>
  </div>
  {category && guide && (
    <section class="pressure-guide-callout">
      <div class="container">
        <div>
          <span class="eyebrow">{l(locale, 'ÜRÜN NOTLARI', 'PRODUCT NOTES')}</span>
          <h2>{guide.title[locale]}</h2>
          <p>{guide.excerpt[locale]}</p>
        </div>
        <a class="button" href={url(locale, 'guides', guide.slug[locale])}>
          {l(locale, 'Rehberi okuyun', 'Read the guide')}
        </a>
      </div>
    </section>
  )}
  <script>
    import { initCatalogue } from '../scripts/catalogue';
    initCatalogue();
  </script>
</Layout>
