---
import type { Locale, Machine } from '../lib/types';
import { labels, l, url, formatNumber } from '../lib/i18n';
import Media from './Media.astro';
import { getContent } from '../lib/content';
interface Props {
  machine: Machine;
  locale: Locale;
  priority?: boolean;
  compact?: boolean;
}
const { machine, locale, priority = false, compact = false } = Astro.props;
const copy = labels(locale);
const brandName =
  (await getContent()).brands.find((brand) => brand.id === machine.brandId && brand.verified)
    ?.name || '';
const href = url(locale, 'machines', machine.slug[locale]);
const categoryLabels: Record<string, string> = {
  excavators: l(locale, 'Paletli ekskavatör', 'Crawler excavator'),
  loaders: l(locale, 'Lastikli yükleyici', 'Wheel loader'),
  road: l(locale, 'Zemin silindiri', 'Soil compactor'),
  lifting: l(locale, 'Teleskopik yükleyici', 'Telescopic handler'),
  attachments: l(locale, 'Ataşman', 'Attachment'),
};
---

<article
  class:list={['machine-card', { 'machine-card-compact': compact }]}
  data-machine-card
  data-id={machine.id}
  data-search={brandName + ' ' + machine.model + ' ' + machine.name[locale]}
  data-category={machine.categoryId}
  data-brand={machine.brandId || ''}
  data-kind={machine.kind}
  data-year={machine.year || ''}
  data-hours={machine.hours ?? ''}
>
  <a class="machine-image" href={href} aria-label={machine.name[locale]}>
    <Media
      src={machine.images[0].src}
      alt={machine.images[0].alt[locale]}
      width="900"
      height="450"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="machine-card-body">
    <div class="machine-card-labels">
      <span class:list={['kind-tag', machine.kind]}>{copy[machine.kind]}</span>
      {machine.sample && <span class="sample-tag">{copy.sample}</span>}
    </div>
    <h3>
      <a href={href}>{machine.model}</a>
    </h3>
    <p class="machine-category">
      {machine.sample
        ? categoryLabels[machine.categoryId]
        : machine.name[locale].replace(machine.model + ' ', '')}
    </p>
    {machine.kind === 'used' && (
      <p class="card-unit-facts">
        {machine.year} · {formatNumber(machine.hours || 0, locale)} {l(locale, 'saat', 'h')}
      </p>
    )}
    {machine.status !== 'available' && (
      <span class:list={['card-stock', machine.status]}>
        {copy[machine.status]}
        {machine.sample && l(locale, ' · Örnek durum', ' · Sample status')}
      </span>
    )}
    <a
      class="text-link card-view"
      href={
        compact && machine.status === 'sold'
          ? url(locale, 'machines') + '?category=' + machine.categoryId
          : href
      }
    >
      {compact && machine.status === 'sold'
        ? l(locale, 'Benzer makineleri inceleyin', 'View alternatives')
        : copy.details}
    </a>
  </div>
</article>
