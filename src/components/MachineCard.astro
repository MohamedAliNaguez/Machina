---
import type { Locale, Machine } from '../lib/types';
import { labels, l, url } from '../lib/i18n';
import ProductVisual from './ProductVisual.astro';
import { getContent } from '../lib/content';
import { getProductModel } from '../lib/product-models';
interface Props {
  machine: Machine;
  locale: Locale;
  priority?: boolean;
  compact?: boolean;
}
const { machine, locale, priority = false, compact = false } = Astro.props;
const copy = labels(locale);
const { categories } = await getContent();
const category = categories.find((item) => item.id === machine.categoryId)!;
const href = url(locale, 'machines', machine.slug[locale]);
---

<article
  class:list={['machine-card', 'pressure-product-card', { 'machine-card-compact': compact }]}
  data-machine-card
  data-id={machine.id}
  data-search={`${machine.model} ${machine.name[locale]} ${category.name[locale]} ${machine.summary[locale]}`}
  data-category={machine.categoryId}
>
  <a
    class="machine-image"
    href={href}
    aria-label={
      machine.name[locale] +
      (machine.images[0].placeholder
        ? ' · ' + l(locale, 'Ürün fotoğrafı eklenecek', 'Product photography pending')
        : '')
    }
  >
    {getProductModel(machine.id) && (
      <span class="product-model-badge">{l(locale, '3D önizleme', '3D preview')}</span>
    )}
    <ProductVisual
      src={machine.images[0].src}
      alt={machine.images[0].alt[locale]}
      locale={locale}
      placeholder={machine.images[0].placeholder}
      priority={priority}
    />
  </a>
  <div class="machine-card-body">
    <div class="machine-card-labels">
      <span class="pressure-product-type">{category.name[locale]}</span>
      {machine.sample && (
        <span class="sample-tag">
          {machine.reference ? l(locale, 'İnceleme bekliyor', 'Review pending') : copy.sample}
        </span>
      )}
    </div>
    <h3>
      <a href={href}>{machine.name[locale]}</a>
    </h3>
    <p class="machine-category">{machine.summary[locale]}</p>
    {!machine.sample && machine.status !== 'available' && (
      <span class:list={['card-stock', machine.status]}>{copy[machine.status]}</span>
    )}
    <a class="text-link card-view" href={href}>
      {l(locale, 'Ürünü inceleyin', 'View product')}
    </a>
  </div>
</article>
