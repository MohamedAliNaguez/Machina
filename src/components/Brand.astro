---
import { withBase } from '../lib/paths';
import brand from '../data/brand.json';
interface Props {
  variant?: 'default' | 'light';
  class?: string;
  decorative?: boolean;
}
const { variant = 'default', class: className, decorative = false } = Astro.props;
---

<img
  class:list={['brand-logo', className]}
  src={withBase(
    variant === 'light' ? '/brand/technicsan-light.svg' : '/brand/technicsan-white-4k.png',
  )}
  srcset={
    variant === 'default'
      ? [480, 960, 1440]
          .map((w) => `${withBase('/brand/technicsan-white-' + w + '.webp')} ${w}w`)
          .join(', ')
      : undefined
  }
  sizes={variant === 'default' ? '(max-width: 760px) 210px, 270px' : undefined}
  alt={decorative ? '' : 'TECHNICSAN — ' + brand.slogan}
  width={variant === 'light' ? 1382 : 4096}
  height={variant === 'light' ? 231 : 800}
  decoding="async"
  fetchpriority="high"
/>
