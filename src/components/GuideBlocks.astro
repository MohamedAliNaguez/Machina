---
import type { GuideBlock } from '../lib/guides';
import type { Locale } from '../lib/types';
import { withBase } from '../lib/paths';
import { l } from '../lib/i18n';
const { blocks, locale } = Astro.props as { blocks: GuideBlock[]; locale: Locale };
---

{blocks.map((block) => (
  <>
    {block.kind === 'paragraph' && <p>{block.text?.[locale]}</p>}
    {block.kind === 'list' && (
      <ul>
        {block.items?.map((item) => (
          <li>{item[locale]}</li>
        ))}
      </ul>
    )}
    {block.kind === 'checklist' && (
      <ul
        class="guide-checklist"
        aria-label={l(locale, 'Hazırlık kontrol listesi', 'Preparation checklist')}
      >
        {block.items?.map((item) => (
          <li>{item[locale]}</li>
        ))}
      </ul>
    )}
    {block.kind === 'table' && (
      <div
        class="guide-table"
        role="region"
        tabindex="0"
        aria-label={l(locale, 'Karşılaştırma tablosu', 'Comparison table')}
      >
        <table>
          <thead>
            <tr>
              {block.columns?.map((c) => (
                <th scope="col">{c[locale]}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {block.rows?.map((row) => (
              <tr>
                {row.cells.map((cell, index) =>
                  index === 0 ? <th scope="row">{cell[locale]}</th> : <td>{cell[locale]}</td>,
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {block.kind === 'figure' && block.image && (
      <figure>
        <img
          src={withBase(block.image.src)}
          alt={block.image.alt[locale]}
          loading="lazy"
          width="1200"
          height="800"
        />
        <figcaption>{block.caption?.[locale]}</figcaption>
      </figure>
    )}
  </>
))}
