---
import { withBase } from '../lib/paths';
import GuideBlocks from './GuideBlocks.astro';
import GuideTool from './GuideTool.astro';
import { readingMinutes } from '../lib/guides';
import '../styles/guides.css';
import Layout from '../layouts/Layout.astro';

import MachineCard from './MachineCard.astro';
import { getContent } from '../lib/content';
import { labels, l, url, otherLocale } from '../lib/i18n';
import type { Article, Locale } from '../lib/types';
interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;
const { categories, machines } = await getContent();
const category = categories.find((c) => c.id === article.categoryId);
const related = (article.relatedProductIds || []).flatMap((id) =>
  machines.filter((m) => m.id === id && m.published.includes(locale)),
);
const enquiryHref =
  url(locale, 'contact') +
  '?guide=' +
  encodeURIComponent(article.id) +
  '&family=' +
  encodeURIComponent(article.categoryId);
const origin = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const schema = article.sample
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Article',
        '@id': new URL(url(locale, 'guides', article.slug[locale]), origin).href + '#article',
        mainEntityOfPage: {
          '@id': new URL(url(locale, 'guides', article.slug[locale]), origin).href + '#webpage',
        },
        datePublished: article.publishedAt,
        headline: article.title[locale],
        description: article.excerpt[locale],
        image: new URL(withBase(article.image), origin).href,
        author: article.author ? { '@type': 'Person', name: article.author } : undefined,
        dateModified:
          article.publishedAt && article.reviewedAt
            ? Date.parse(article.reviewedAt) >= Date.parse(article.publishedAt)
              ? article.reviewedAt
              : article.publishedAt
            : undefined,
        contributor: article.reviewer ? { '@type': 'Person', name: article.reviewer } : undefined,
        inLanguage: locale,
        publisher: { '@id': new URL('/#organization', origin).href },
      },
    ];

const answer = article.excerpt[locale];
---

<Layout
  locale={locale}
  title={article.title[locale]}
  description={article.excerpt[locale]}
  section="guides"
  alternate={
    article.published.includes(otherLocale(locale))
      ? url(otherLocale(locale), 'guides', article.slug[otherLocale(locale)])
      : undefined
  }
  breadcrumbs={[
    { name: labels(locale).guides, href: url(locale, 'guides') },
    { name: article.title[locale] },
  ]}
  schema={schema}
  socialImage={article.image}
>
  <header class="guide-article-hero">
    <div class="container guide-cover-bar">
      <a class="guide-back" href={url(locale, 'guides')}>
        {l(locale, 'TECHNICSAN / REHBERLER', 'TECHNICSAN / GUIDES')}
      </a>
      <span>{l(locale, 'DAHA İYİ KARARLAR İÇİN', 'KNOWLEDGE FOR BETTER DECISIONS')}</span>
    </div>
    <div class="container guide-hero-grid">
      <div class="guide-hero-copy">
        <div class="guide-hero-label">
          <span>{category?.name[locale] || article.tag[locale]}</span>
          {article.sample && (
            <span class="guide-review-label">
              {l(locale, 'İnceleme nüshası', 'Review edition')}
            </span>
          )}
        </div>
        <h1>{article.title[locale]}</h1>
        <p class="guide-hero-deck">{answer}</p>
      </div>
      <figure class="guide-hero-visual">
        <img
          src={withBase(article.image)}
          alt={article.imageAlt?.[locale] || ''}
          width="1200"
          height="800"
          fetchpriority="high"
        />
        <figcaption>
          <span>TECHNICSAN</span>
          <span>{l(locale, 'ÜRÜN VE UYGULAMA', 'EQUIPMENT & APPLICATION')}</span>
        </figcaption>
      </figure>
    </div>
    <div class="guide-facts-band">
      <div class="container guide-facts">
        <div>
          <span>{l(locale, 'ÜRÜN GRUBU', 'PRODUCT FAMILY')}</span>
          <strong>{category?.name[locale]}</strong>
        </div>
        <div>
          <span>{l(locale, 'OKUMA SÜRESİ', 'READING TIME')}</span>
          <strong>
            {readingMinutes(article, locale)} {l(locale, 'dakika', 'minutes')}
          </strong>
        </div>
        <div>
          <span>{l(locale, 'REHBER İÇERİĞİ', 'GUIDE STRUCTURE')}</span>
          <strong>
            {article.sections.length} {l(locale, 'odaklı bölüm', 'focused sections')}
          </strong>
        </div>
      </div>
    </div>
  </header>
  <div class="container guide-reader">
    <aside class="guide-sidebar">
      <div class="guide-rail-heading">
        <span class="guide-rail-mark" aria-hidden="true"></span>
        <span>
          TECHNICSAN
          <br />
          {l(locale, 'BİLGİ REHBERİ', 'FIELD GUIDE')}
        </span>
      </div>
      <details class="guide-outline" open>
        <summary>
          {l(locale, 'Bu rehberde', 'Inside this guide')}
          <span>{String(article.sections.length).padStart(2, '0')}</span>
        </summary>
        <nav aria-label={l(locale, 'Bu sayfada', 'On this page')}>
          {article.sections.map((section, index) => (
            <a href={'#article-section-' + index}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {section.heading[locale]}
            </a>
          ))}
        </nav>
      </details>
      <div class="guide-sidebar-tools">
        <button type="button" class="guide-print">
          {l(locale, 'Rehberi yazdır', 'Print this guide')}
        </button>
        {category && (
          <a href={url(locale, 'categories', category.slug[locale])}>
            {l(locale, 'Ürün grubunu inceleyin', 'Explore the product family')}
          </a>
        )}
      </div>
    </aside>
    <article class="guide-prose" data-guide-id={article.id} data-guide-family={article.categoryId}>
      {!article.sample && (article.author || article.reviewedAt) && (
        <div class="article-byline">
          {article.author}
          {article.reviewer && ' · ' + l(locale, 'İnceleyen: ', 'Reviewer: ') + article.reviewer}
          {article.reviewedAt &&
            ' · ' +
              l(locale, 'İnceleme: ', 'Reviewed: ') +
              new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-GB', {
                dateStyle: 'long',
                timeZone: 'Europe/Istanbul',
              }).format(new Date(article.reviewedAt))}
        </div>
      )}
      {article.publishedAt && !article.sample && (
        <p>
          {l(locale, 'Yayımlanma: ', 'Published: ')}
          <time datetime={article.publishedAt}>
            {new Date(article.publishedAt).toLocaleDateString(locale)}
          </time>
        </p>
      )}
      {article.sections.map((section, index) => (
        <section class="guide-section" id={'article-section-' + index}>
          <h2>
            <span class="guide-section-no" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            {section.heading[locale]}
          </h2>
          {section.blocks?.length ? (
            <GuideBlocks blocks={section.blocks} locale={locale} />
          ) : (
            section.text[locale].split('\n\n').map((paragraph) => <p>{paragraph}</p>)
          )}
          {section.tool && <GuideTool kind={section.tool} locale={locale} guideId={article.id} />}
        </section>
      ))}
      {article.sources.length > 0 && (
        <section>
          <h2>{l(locale, 'Kaynaklar', 'Sources')}</h2>
          <ul>
            {article.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {related.length > 0 && (
        <div class="article-related">
          <h2>{l(locale, 'İlgili ekipmanlar', 'Related equipment')}</h2>
          {related.map((machine) => (
            <div data-guide-product={article.id}>
              <MachineCard machine={machine} locale={locale} />
            </div>
          ))}
        </div>
      )}
      {category && (
        <a class="text-link" href={url(locale, 'categories', category.slug[locale])}>
          {l(locale, 'İlgili ürünleri inceleyin', 'Explore related products')}
        </a>
      )}
      {!article.sections.some((section) => section.tool === 'rfq') && (
        <aside class="guide-enquiry">
          <span class="guide-kicker">{l(locale, 'BİR SONRAKİ ADIM', 'THE NEXT STEP')}</span>
          <h2>{l(locale, 'Gereksinimlerinizi görüşün', 'Discuss your requirements')}</h2>
          <p>
            {l(
              locale,
              'Uygulamanızı, hedef ülkeyi ve bilinen gereksinimleri paylaşın.',
              'Share your application, destination and known requirements.',
            )}
          </p>
          <a class="button" href={enquiryHref}>
            {l(locale, 'Projeniz hakkında konuşalım', 'Discuss your project')}
          </a>
        </aside>
      )}
    </article>
  </div>
</Layout>

<script>
  document.querySelector('.guide-print')?.addEventListener('click', () => window.print());
  const outline = document.querySelector<HTMLDetailsElement>('.guide-outline');
  if (outline && matchMedia('(max-width: 900px)').matches) outline.open = false;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.guide-section'));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.guide-outline nav a'));
  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries
          .filter((item) => item.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!entry) return;
        links.forEach((link) => {
          if (link.hash === '#' + entry.target.id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-120px 0px -45% 0px', threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
