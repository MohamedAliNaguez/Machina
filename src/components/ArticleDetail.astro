---
import { withBase } from '../lib/paths';
import GuideBlocks from './GuideBlocks.astro';
import { readingMinutes } from '../lib/guides';
import '../styles/guides.css';
import Layout from '../layouts/Layout.astro';

import MachineCard from './MachineCard.astro';
import { getContent } from '../lib/content';
import { labels, l, url, otherLocale } from '../lib/i18n';
import type { Article, Locale } from '../lib/types';
interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;
const { categories, machines } = await getContent();
const category = categories.find((c) => c.id === article.categoryId);
const related = (article.relatedProductIds || []).flatMap((id) =>
  machines.filter((m) => m.id === id && m.published.includes(locale)),
);
const enquiryHref =
  url(locale, 'contact') +
  '?guide=' +
  encodeURIComponent(article.id) +
  '&family=' +
  encodeURIComponent(article.categoryId);
const origin = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const schema = article.sample
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Article',
        '@id': new URL(url(locale, 'guides', article.slug[locale]), origin).href + '#article',
        mainEntityOfPage: {
          '@id': new URL(url(locale, 'guides', article.slug[locale]), origin).href + '#webpage',
        },
        datePublished: article.publishedAt,
        headline: article.title[locale],
        description: article.excerpt[locale],
        image: new URL(withBase(article.image), origin).href,
        author: article.author ? { '@type': 'Person', name: article.author } : undefined,
        dateModified:
          article.publishedAt && article.reviewedAt
            ? Date.parse(article.reviewedAt) >= Date.parse(article.publishedAt)
              ? article.reviewedAt
              : article.publishedAt
            : undefined,
        contributor: article.reviewer ? { '@type': 'Person', name: article.reviewer } : undefined,
        inLanguage: locale,
        publisher: { '@id': new URL('/#organization', origin).href },
      },
    ];

const answer = article.excerpt[locale];
---

<Layout
  locale={locale}
  title={article.title[locale]}
  description={article.excerpt[locale]}
  section="guides"
  alternate={
    article.published.includes(otherLocale(locale))
      ? url(otherLocale(locale), 'guides', article.slug[otherLocale(locale)])
      : undefined
  }
  breadcrumbs={[
    { name: labels(locale).guides, href: url(locale, 'guides') },
    { name: article.title[locale] },
  ]}
  schema={schema}
  socialImage={article.image}
>
  <header class="guide-hub-intro">
    <div class="container">
      <span class="eyebrow">
        TECHNICSAN / {article.tag[locale]}
        {article.sample ? l(locale, ' · TASLAK', ' · DRAFT') : ''}
      </span>
      <h1>{article.title[locale]}</h1>
    </div>
  </header>
  <div class="container guide-reader">
    <nav class="reading-outline" aria-label={l(locale, 'Bu sayfada', 'On this page')}>
      <span>{l(locale, 'BU SAYFADA', 'ON THIS PAGE')}</span>
      {article.sections.map((section, index) => (
        <a href={'#article-section-' + index}>{section.heading[locale]}</a>
      ))}
    </nav>
    <article class="steel-prose" data-guide-id={article.id} data-guide-family={article.categoryId}>
      <p>
        {readingMinutes(article, locale)} {l(locale, 'dakika okuma', 'minute read')}
      </p>
      <button type="button" class="guide-print">
        {l(locale, 'Rehberi yazdır', 'Print guide')}
      </button>
      {!article.sample && (article.author || article.reviewedAt) && (
        <div class="article-byline">
          {article.author}
          {article.reviewer && ' · ' + l(locale, 'İnceleyen: ', 'Reviewer: ') + article.reviewer}
          {article.reviewedAt &&
            ' · ' +
              l(locale, 'İnceleme: ', 'Reviewed: ') +
              new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-GB', {
                dateStyle: 'long',
                timeZone: 'Europe/Istanbul',
              }).format(new Date(article.reviewedAt))}
        </div>
      )}
      {article.publishedAt && !article.sample && (
        <p>
          {l(locale, 'Yayımlanma: ', 'Published: ')}
          <time datetime={article.publishedAt}>
            {new Date(article.publishedAt).toLocaleDateString(locale)}
          </time>
        </p>
      )}
      {category && (
        <a class="text-link" href={url(locale, 'categories', category.slug[locale])}>
          {category.name[locale]}
        </a>
      )}
      <div class="article-answer">
        <h2>{l(locale, 'Kısa yanıt', 'At a glance')}</h2>
        <p>{answer}</p>
      </div>
      {article.sections.map((section, index) => (
        <section id={'article-section-' + index}>
          <h2>{section.heading[locale]}</h2>
          {section.blocks?.length ? (
            <GuideBlocks blocks={section.blocks} locale={locale} />
          ) : (
            section.text[locale].split('\n\n').map((paragraph) => <p>{paragraph}</p>)
          )}
          {index === 0 && (
            <>
              <img
                class="article-inline-image guide-cover"
                src={withBase(article.image)}
                alt={article.imageAlt?.[locale] || ''}
                width="1200"
                height="500"
                loading="eager"
              />
              {article.sample && (
                <p class="article-image-caption">
                  {l(locale, 'Ürün fotoğrafı eklenecek', 'Product photography pending')}
                </p>
              )}
            </>
          )}
        </section>
      ))}
      {article.sources.length > 0 && (
        <section>
          <h2>{l(locale, 'Kaynaklar', 'Sources')}</h2>
          <ul>
            {article.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {related.length > 0 && (
        <div class="article-related">
          <h2>{l(locale, 'İlgili ekipmanlar', 'Related equipment')}</h2>
          {related.map((machine) => (
            <div data-guide-product={article.id}>
              <MachineCard machine={machine} locale={locale} compact />
            </div>
          ))}
        </div>
      )}
      {category && (
        <a class="text-link" href={url(locale, 'categories', category.slug[locale])}>
          {l(locale, 'İlgili ürünleri inceleyin', 'Explore related products')}
        </a>
      )}
      <aside class="guide-enquiry">
        <h2>{l(locale, 'Gereksinimlerinizi görüşün', 'Discuss your requirements')}</h2>
        <p>
          {l(
            locale,
            'Uygulamanızı, hedef ülkeyi ve bilinen gereksinimleri paylaşın.',
            'Share your application, destination and known requirements.',
          )}
        </p>
        <a class="button" href={enquiryHref}>
          {l(locale, 'Projeniz hakkında konuşalım', 'Discuss your project')}
        </a>
      </aside>
    </article>
  </div>
</Layout>

<script>
  document.querySelector('.guide-print')?.addEventListener('click', () => window.print());
</script>
