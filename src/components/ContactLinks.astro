---
import { directContactLinks, type ContactProduct } from '../lib/contact';
import { l } from '../lib/i18n';
import type { Locale, Settings } from '../lib/types';

interface Props {
  locale: Locale;
  settings: Settings;
  product?: ContactProduct;
  layout?: 'inline' | 'stacked';
  theme?: 'light' | 'dark';
}
const { locale, settings, product, layout = 'inline', theme = 'light' } = Astro.props;
const links = directContactLinks(settings, locale, product);
---

{links.length > 0 && (
  <nav
    class="direct-contact"
    data-layout={layout}
    data-theme={theme}
    aria-label={l(locale, 'Doğrudan iletişim', 'Direct contact')}
  >
    {links.map((link) => (
      <div class="direct-contact-channel">
        {layout === 'stacked' && <strong>{link.label}</strong>}
        <a
          href={link.href}
          data-contact-channel={link.channel}
          target={link.channel === 'whatsapp' ? '_blank' : undefined}
          rel={link.channel === 'whatsapp' ? 'noopener noreferrer' : undefined}
        >
          {link.value}
          {link.channel === 'whatsapp' && (
            <span class="sr-only">{l(locale, ' (yeni sekme)', ' (new tab)')}</span>
          )}
        </a>
      </div>
    ))}
  </nav>
)}

<style>
  .direct-contact {
    display: flex;
    flex-wrap: wrap;
    column-gap: 28px;
    row-gap: 4px;
    color: var(--primary);
    font-size: 16px;
    font-weight: 600;
  }
  .direct-contact-channel {
    min-width: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  [data-theme='dark'] {
    color: var(--stage-ink);
  }
  [data-theme='dark'] a:hover {
    color: var(--accent);
  }
  [data-theme='dark'] a:focus-visible {
    outline-color: var(--accent);
  }
  [data-layout='stacked'] {
    display: grid;
    gap: 20px;
    margin-top: 26px;
    font-size: 18px;
    font-weight: 400;
  }
  [data-layout='stacked'] strong {
    display: block;
    color: var(--graphite);
    font-size: 16px;
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .direct-contact {
      column-gap: 20px;
    }
  }
</style>
