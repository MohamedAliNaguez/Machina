---
import brand from '../data/brand.json';
import HistoryCanopy from './HistoryCanopy.astro';
import Layout from '../layouts/Layout.astro';
import SteelIntro from './SteelIntro.astro';
import ContactPressure from './ContactPressure.astro';
import { hostedEnquiryEndpoint } from '../lib/sales-email';
import { getContent } from '../lib/content';
import { labels, l, otherLocale, url, type Section } from '../lib/i18n';
import type { Locale } from '../lib/types';
interface Props {
  locale: Locale;
  section: Section;
}
const { locale, section } = Astro.props;
const { settings, articles, brands, categories: allCategories } = await getContent();
const categories = allCategories.filter((c) => (c.published ?? ['en', 'tr']).includes(locale));
const copy = labels(locale),
  visibleArticles = articles.filter((a) => a.published.includes(locale));

const titles: Record<Section, string> = {
  guides: l(locale, 'REHBERLER', 'GUIDES'),
  about: l(locale, 'BASINÇ\nODAĞIMIZDA', 'PRESSURE\nAT THE CORE'),
  contact: l(locale, 'İLETİŞİM', "LET'S TALK"),
  privacy: l(locale, 'GİZLİLİK', 'PRIVACY'),
  brands: l(locale, 'MARKALAR', 'BRANDS'),
  machines: copy.machines,
  categories: l(locale, 'KATEGORİLER', 'CATEGORIES'),
};
const descriptions: Record<Section, string> = {
  guides: l(
    locale,
    'Ürün ihtiyaçlarınız için görüşme notları',
    'Conversation notes for your product requirements',
  ),
  about: l(locale, 'Beş ürün grubu · Tek TECHNICSAN', 'Five product types · One TECHNICSAN'),
  contact: l(
    locale,
    'Uygulamanız ve ürün ihtiyacınız hakkında konuşalım',
    'Tell us about your application and product requirements',
  ),
  privacy: l(locale, 'Gizlilik bildirimi', 'Privacy notice'),
  brands: l(locale, 'Doğrulanmış marka bilgileri', 'Verified brand information'),
  machines: '',
  categories: '',
};
const title = titles[section];
const privacySections = [
  {
    id: 'controller',
    title: l(locale, 'Talepleri kim yönetir', 'Who handles enquiries'),
    text: l(
      locale,
      hostedEnquiryEndpoint
        ? `TECHNICSAN satış taleplerine ${settings.email} adresinden yanıt verir.`
        : 'Doğrulanmış şirket adı ve gizlilik iletişim bilgileri burada yer alacaktır.',
      hostedEnquiryEndpoint
        ? `TECHNICSAN responds to sales enquiries through ${settings.email}.`
        : 'Verified company name and privacy contact will appear here. This section will set out who is responsible for handling enquiries submitted through this website.',
    ),
  },
  {
    id: 'information',
    title: l(locale, 'Paylaştığınız bilgiler', 'Information you provide'),
    text: l(
      locale,
      hostedEnquiryEndpoint
        ? 'Form, adınızı, e-posta veya telefonunuzu, mesajınızı, isteğe bağlı ürün seçiminizi ve dili iletir. Bir talep referansı ve formun sayfa adresi de eklenir.'
        : 'Bu bölüm, talep formu aracılığıyla istenen bilgileri ve nasıl toplandığını açıklayacaktır.',
      hostedEnquiryEndpoint
        ? 'The form submits your name, email or phone, message, optional product selection and language. An enquiry reference, the form page address and an optional originating guide reference and product family are also included.'
        : 'This section will describe the information requested through the enquiry form, and how it is collected.',
    ),
  },
  {
    id: 'retention',
    title: l(locale, 'Kullanım ve saklama', 'Use and retention'),
    text: l(
      locale,
      hostedEnquiryEndpoint
        ? 'Talepler, yanıt verilmek üzere Formspree üzerinden iletilir; Formspree hesabında ve satış e-posta kutusunda saklanır. Saklama ve silme ile ilgili sorularınızı satış iletişim adresine iletebilirsiniz.'
        : 'Onaylanmış işleme amaçları, hizmet sağlayıcıları ve saklama bilgileri onaylı metinde yer alacaktır.',
      hostedEnquiryEndpoint
        ? 'Enquiries are sent through Formspree so sales can respond, and are stored in the Formspree account and sales mailbox. Contact sales with questions about retention or deletion.'
        : 'Confirmed processing purposes, service providers and retention information will appear in the approved notice.',
    ),
  },
  {
    id: 'privacy-contact',
    title: l(locale, 'İletişim', 'Your contact'),
    text: l(
      locale,
      settings.email
        ? `Bilgilerinizle ilgili sorularınızı ${settings.email} adresine iletebilirsiniz.`
        : 'Gizlilik talepleri için onaylanmış iletişim kanalı burada yer alacaktır.',
      settings.email
        ? `For questions about your information, contact ${settings.email}.`
        : 'The approved contact route for privacy requests will appear here.',
    ),
  },
];
---

<Layout
  locale={locale}
  title={title.replace('\n', ' ')}
  description={descriptions[section]}
  section={section}
  noindex={section === 'brands' && !brands.some((b) => b.verified)}
  alternate={url(otherLocale(locale), section)}
  breadcrumbs={[
    {
      name:
        section === 'privacy'
          ? descriptions.privacy
          : copy[section as 'guides' | 'about' | 'contact' | 'brands'] || title,
    },
  ]}
>
  {section !== 'about' && section !== 'contact' && (
    <SteelIntro
      locale={locale}
      title={title}
      subtitle={descriptions[section]}
      variant={'information-intro ' + section + '-intro'}
      note={
        section === 'guides' && visibleArticles.some((a) => a.sample)
          ? l(locale, 'Önizleme içerikleri · Taslak rehberler', 'Preview content · Draft articles')
          : undefined
      }
    />
  )}
  {section === 'about' && (
    <>
      <HistoryCanopy locale={locale} />
      <section class="container steel-about">
        <div class="about-copy">
          <h2>
            {l(locale, 'Beş ürün grubu, net bir odak', 'Five product types, one clear focus')}
          </h2>
          <p>
            {settings.about?.[locale] ||
              l(
                locale,
                brand.slogan +
                  ' TECHNICSAN kimliğinin merkezinde basınç yer alır. Kataloğumuz çimento silobası, LPG kataloğu, kompresörler, mikserler ve silolardan oluşur.',
                brand.slogan +
                  ' Pressure sits at the heart of the TECHNICSAN identity. Our catalogue consists of Cement bulker, LPG catalog, Compressors, Mixers and Silos.',
              )}
          </p>
          {!settings.identityVerified && (
            <p class="about-pending">
              {l(
                locale,
                'Şirket geçmişi, ekip tanıtımları ve doğrulanmış destek hizmetleri inceleme sonrasında eklenecektir',
                'Company history, team introductions and confirmed support services will be added after review',
              )}
            </p>
          )}
        </div>
        <div class="pressure-about-types">
          {categories.map((category, index) => (
            <a href={url(locale, 'categories', category.slug[locale])}>
              <span>0{index + 1}</span>
              <strong>{category.name[locale]}</strong>
            </a>
          ))}
        </div>
      </section>
      <section class="photo-callout about-callout">
        <div class="container">
          <div>
            <h2>{l(locale, 'Doğru bilgilerle başlayın', 'Start with the right information')}</h2>
            <div class="callout-actions">
              <a class="button" href={url(locale, 'machines')}>
                {l(locale, 'Ürünleri inceleyin', 'Browse products')}
              </a>
              <a href={url(locale, 'contact')}>
                {l(locale, 'Satış ekibiyle görüşün', 'Contact sales')}
              </a>
            </div>
            {!settings.identityVerified && (
              <p class="callout-note">
                {l(
                  locale,
                  'Şirket bilgileri doğrulanmayı bekliyor',
                  'Business details pending verification',
                )}
              </p>
            )}
          </div>
        </div>
      </section>
    </>
  )}
  {section === 'contact' && <ContactPressure locale={locale} settings={settings} />}
  {section === 'privacy' && (
    <div class="container steel-reading privacy-reading">
      {!settings.privacyNotice?.[locale] && (
        <nav class="reading-outline" aria-label={l(locale, 'Bu sayfada', 'On this page')}>
          <span>{l(locale, 'BU SAYFADA', 'ON THIS PAGE')}</span>
          {privacySections.map((item) => (
            <a href={'#' + item.id}>{item.title}</a>
          ))}
        </nav>
      )}
      <article class="steel-prose">
        {settings.privacyNotice?.[locale] ? (
          <p>{settings.privacyNotice[locale]}</p>
        ) : (
          <>
            <div class="draft-notice">
              <strong>
                {l(
                  locale,
                  'TASLAK DÜZEN · İÇERİK İNCELEME BEKLİYOR',
                  'DRAFT LAYOUT · CONTENT PENDING REVIEW',
                )}
              </strong>
              <p>
                {l(
                  locale,
                  hostedEnquiryEndpoint
                    ? 'Şirketin tam gizlilik bildirimi inceleme aşamasındadır. Aşağıdaki bilgiler, etkin satış talep formunun nasıl çalıştığını açıklar.'
                    : 'Şirketin onaylı gizlilik bildirimi yayımdan önce tamamlanacaktır. Bu önizlemede yalnızca örnek bilgiler kullanın.',
                  hostedEnquiryEndpoint
                    ? 'The full company notice is under review. The information below explains how the active sales enquiry form works.'
                    : 'The company notice must be completed before launch. Use sample information only in this preview.',
                )}
              </p>
            </div>
            {hostedEnquiryEndpoint && (
              <section>
                <h2>{l(locale, 'Satış talep formu', 'Sales enquiry form')}</h2>
                <p>
                  {l(
                    locale,
                    `Formdaki ad, e-posta veya telefon, mesaj, seçilen ürün ve dil bilgileri, talebinize yanıt verilmesi amacıyla Formspree'ye gönderilir ve TECHNICSAN satış iletişim adresi ${settings.email} üzerinden işlenir. Talepler Formspree hesabında ve satış e-posta kutusunda saklanır.`,
                    `The form sends your name, email or phone, message, selected product and language to Formspree for TECHNICSAN to respond to your enquiry at ${settings.email}. Enquiries are stored in the Formspree account and the sales mailbox.`,
                  )}
                </p>
                <p>
                  <a
                    href="https://formspree.io/legal/privacy-policy/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {l(locale, 'Formspree gizlilik politikası', 'Formspree privacy policy')}
                  </a>
                </p>
                <p>
                  {l(
                    locale,
                    'Verilerinizle ilgili sorular için: ',
                    'For questions about your information: ',
                  )}
                  <a href={'mailto:' + settings.email}>{settings.email}</a>
                </p>
              </section>
            )}
            {privacySections.map((item) => (
              <section id={item.id}>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </section>
            ))}
          </>
        )}
        <a class="text-link" href={url(locale, 'contact')}>
          {l(locale, 'İletişime dönün', 'Return to contact')}
        </a>
      </article>
    </div>
  )}
  {section === 'brands' && (
    <section class="container steel-brand-list">
      {brands.some((b) => b.verified) ? (
        brands
          .filter((b) => b.verified)
          .map((brand) => (
            <article>
              <h2>{brand.name}</h2>
              <p>{brand.description[locale]}</p>
              <a
                class="text-link"
                href={url(locale, 'machines') + '?brand=' + encodeURIComponent(brand.id)}
              >
                {copy.machines}
              </a>
            </article>
          ))
      ) : (
        <div class="empty-state">
          <h2>
            {l(locale, 'Marka bilgileri hazırlanıyor', 'Brand information is being prepared')}
          </h2>
          <p>
            {l(
              locale,
              'Yalnızca doğrulanmış marka bilgileri yayımlanacaktır',
              'Only verified brand information will be published',
            )}
          </p>
          <a class="button" href={url(locale, 'machines')}>
            {copy.all}
          </a>
        </div>
      )}
    </section>
  )}
</Layout>
