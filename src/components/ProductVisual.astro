---
import { productImageUrl, productImageSrcset } from '../lib/image-delivery';
import { withBase } from '../lib/paths';
import { l } from '../lib/i18n';
import type { Locale } from '../lib/types';
interface Props {
  id?: string;
  src: string;
  alt: string;
  locale: Locale;
  placeholder?: boolean;
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const {
  id,
  src,
  alt,
  locale,
  placeholder = false,
  priority = false,
  sizes = '(max-width: 900px) 90vw, 60vw',
  class: className,
} = Astro.props;
---

<div class:list={['product-visual', className, { 'product-visual-pending': placeholder }]}>
  <img
    id={id}
    src={withBase(productImageUrl(src, 960))}
    srcset={productImageSrcset(src)}
    sizes={sizes}
    alt={alt}
    width="900"
    height="560"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <span class="photography-pending" hidden={!placeholder}>
    {l(locale, 'Ürün fotoğrafı eklenecek', 'Product photography pending')}
  </span>
</div>
