{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["functions/**/*.ts", "workers/**/*.ts", "src/lib/enquiry*.ts"]
}
