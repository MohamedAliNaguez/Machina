{
  "name": "precision-machinery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build && node scripts/postbuild.mjs && node scripts/verify-build.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:cloudflare": "wrangler pages dev dist --port 4322",
    "db:local": "wrangler d1 migrations apply machinery-enquiries --local",
    "studio": "npm --prefix studio run dev",
    "content:export": "node scripts/export-content.mjs",
    "content:seed": "npm --prefix studio run seed",
    "content:check": "tsx scripts/check-sanity.ts",
    "studio:check": "npm --prefix studio run check",
    "studio:build": "npm --prefix studio run build",
    "verify:launch": "node scripts/verify-launch.mjs",
    "seo:audit": "node scripts/verify-launch.mjs --audit",
    "content:seo-migrate": "npm --prefix studio run seo:migrate",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "cloudflare:build": "node scripts/cloudflare-pages.mjs build",
    "cloudflare:deploy": "node scripts/cloudflare-pages.mjs deploy"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "@google/model-viewer": "^4.4.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.1",
    "libphonenumber-js": "^1.13.17",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "lighthouse": "^13.6.0",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "sharp": "^0.35.5",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
