# Preview defaults work without accounts. Never commit real secrets.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_LAUNCH_READY=false
CONTENT_SOURCE=sanity
# Public project defaults live in src/data/sanity.json. Repository mode remains an offline fallback.
SANITY_PROJECT_ID=orvo6y9t
SANITY_DATASET=production
# Only needed for authenticated draft preview builds (never a PUBLIC variable).
SANITY_READ_TOKEN=
SANITY_PREVIEW=false

# GitHub Pages workflow sets these only for the hosted preview. Local development keeps defaults.
PUBLIC_BASE_PATH=/
PUBLIC_HOSTING=local
# Hosted sales enquiries use src/data/enquiry-delivery.json by default.
# Optional override; an empty value disables hosted form sending.
# PUBLIC_FORMSPREE_FORM_ID=

# Search ownership verification: optional public values from YOUR accounts.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Analytics stays inactive until a property exists AND its privacy configuration is reviewed.
# Disable all GA4 Enhanced Measurement (especially forms, outbound clicks and page history).
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_ANALYTICS_REVIEWED=false

# Current production migration: Cloudflare Pages with the existing Formspree sales inbox.
# npm run cloudflare:build sets these hosting flags automatically.
# PUBLIC_HOSTING=cloudflare
# PUBLIC_ENQUIRY_PROVIDER=formspree
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN are private deployment credentials.
