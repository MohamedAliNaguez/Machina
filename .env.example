# Preview defaults work without accounts. Never commit real secrets.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_LAUNCH_READY=false
CONTENT_SOURCE=sample
# Set both to use published Sanity content. Missing/invalid content fails the build.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed for authenticated draft preview builds (never a PUBLIC variable).
SANITY_READ_TOKEN=
SANITY_PREVIEW=false

# GitHub Pages workflow sets these only for the hosted preview. Local development keeps defaults.
PUBLIC_BASE_PATH=/
PUBLIC_HOSTING=local
